{
  "name": "luggster-ops-workspace",
  "version": "2.0.0",
  "description": "LuggageLink Operations Console - Workspace",
  "private": true,
  "workspaces": [
    "packages/main-worker",
    "packages/driver-stats-worker"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:main": "npm run dev --workspace=packages/main-worker",
    "dev:stats": "npm run dev --workspace=packages/driver-stats-worker",
    "dev:all": "concurrently \"npm run dev:main\" \"npm run dev:stats\"",
    "deploy:main": "npm run deploy --workspace=packages/main-worker",
    "deploy:stats": "npm run deploy --workspace=packages/driver-stats-worker",
    "deploy:all": "npm run deploy:main && npm run deploy:stats",
    "check": "npm run check --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}