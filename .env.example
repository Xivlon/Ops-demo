# LuggageLink Ops - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env or .dev.vars to version control

# Neon PostgreSQL Database URL
DATABASE_URL=postgres://user:password@host.neon.tech/database?sslmode=require

# JWT Secret for token signing (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here

# Role-based PINs (JSON object).
# SECURE MODE (recommended): Set PIN_PEPPER first, then store HMAC-SHA256 hashes:
#   1. Generate pepper: openssl rand -base64 32
#   2. Set PIN_PEPPER below
#   3. Generate hashes: node -e "
#     const pepper='YOUR_PEPPER';
#     const roles={admin:'847291',storage:'563204',transport:'918473'};
#     const crypto=require('crypto');
#     for(const[r,p]of Object.entries(roles)){
#       const h=crypto.createHmac('sha256',pepper).update(p).digest('base64');
#       console.log(r+':',h);
#     }
#   "
#   4. Store the resulting hashes in ROLES as JSON
#
# PLAINTEXT MODE (not recommended): Leave PIN_PEPPER empty and store raw PINs.
#   Admin    -> Full access (dashboard, reports, exports, all operations)
#   Storage  -> Storage page and storage API only
#   Transport -> Shipments page and transport shipments API only
ROLES={"admin":"847291","storage":"563204","transport":"918473"}
PIN_PEPPER=

# JWT Expiry in hours (default: 24)
JWT_EXPIRY_HOURS=24

# Optional: Custom worker URLs (defaults to constance-api.workers.dev domains)
# DRIVER_STATS_WORKER_URL=https://driver-stats.constance-api.workers.dev
# STORAGE_WORKER_URL=https://storage.constance-api.workers.dev
