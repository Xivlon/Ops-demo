# LuggageLink Ops - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env or .dev.vars to version control

# Neon PostgreSQL Database URL
DATABASE_URL=postgres://user:password@host.neon.tech/database?sslmode=require

# JWT Secret for token signing (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here

# Role-based PINs (JSON object). Each PIN grants access to specific features:
#   admin    -> Full access (dashboard, reports, exports, all operations)
#   storage  -> Storage page and storage API only
#   transport -> Driver stats and transport shipments API only
#
# Generate secure 6-digit PINs. Example:
#   node -e "console.log(Math.floor(100000 + Math.random() * 900000))"
ROLES={"admin":"847291","storage":"563204","transport":"918473"}

# JWT Expiry in hours (default: 24)
JWT_EXPIRY_HOURS=24
